# AWS Account Configuration
AWS_ACCOUNT_ID=<your-account-id>
AWS_REGION=<your-region>
CDK_DEFAULT_ACCOUNT=<your-account-id>
CDK_DEFAULT_REGION=<your-region>

# Workflow Engine Docker Image (set after running: ./infra/scripts/build-and-push.sh)
ENGINE_IMAGE_URI=<account>.dkr.ecr.<region>.amazonaws.com/agent-engine/workflow-engine:latest

# API Gateway URL (set after running: npx cdk deploy — copy from AgentEngine.ApiUrl output)
API_URL=https://<id>.execute-api.<region>.amazonaws.com

# Workflow Engine Config
LLM_PROVIDER=bedrock
LOG_LEVEL=info
