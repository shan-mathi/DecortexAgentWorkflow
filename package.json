{
  "name": "agent-workflow-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Agent workflow engine — DAG executor for typed nodes (LLM, HTTP, Branch, Transform, plugins).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run packages/storage/test",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:tickets": "tsx scripts/seed-tickets.ts",
    "seed:workflows": "tsx scripts/seed-workflows.ts",
    "eval": "tsx scripts/eval.ts",
    "load": "tsx scripts/load.ts",
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @workflow-engine/api dev\" \"pnpm --filter @workflow-engine/web dev\""
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
